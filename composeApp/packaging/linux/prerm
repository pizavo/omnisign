#!/bin/sh
# prerm script for APPLICATION_PACKAGE
#
# Extends the default jpackage template with cleanup of the AppStream
# metainfo and hicolor icon installed by postinst.

set -e

package_type=deb
COMMON_SCRIPTS
DESKTOP_SCRIPTS
LAUNCHER_AS_SERVICE_SCRIPTS

case "$1" in
    remove|upgrade|deconfigure)
DESKTOP_COMMANDS_UNINSTALL
LAUNCHER_AS_SERVICE_COMMANDS_UNINSTALL
        rm -f /usr/share/metainfo/cz.pizavo.omnisign.metainfo.xml
        rm -f /usr/share/icons/hicolor/512x512/apps/omnisign.png
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || :
        fi
        if command -v appstreamcli >/dev/null 2>&1; then
            appstreamcli refresh-cache --force >/dev/null 2>&1 || :
        fi
        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
